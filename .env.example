# Ambiente
RH_SERVICE_NAME=conecta-api
RH_APP_ENV=dev
RH_APP_VERSION=0.1.0
RH_LOG_LEVEL=INFO

# Servidor único FastAPI + Front
RH_API_HOST=127.0.0.1
RH_API_PORT=8000
RH_SERVER_RELOAD=false
RH_FRONT_SERVE_STATIC=true
RH_FRONTEND_DIR=apps/frontend
# Deixe vazio para usar a mesma origem da página.
RH_FRONTEND_API_BASE_URL=
RH_PROCESS_DOSSIER_AI_ENDPOINT=
APP_ENV=development
FLASK_SECRET_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTHORITY=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback


# Banco SQL Server
RH_SQL_SERVER=
RH_SQL_DATABASE=Conecta_DEV
RH_SQL_DRIVER=ODBC Driver 18 for SQL Server
RH_SQL_CONNECTION_STRING=
RH_SQL_TRUSTED_CONNECTION=true
RH_SQL_USERNAME=
RH_SQL_PASSWORD=
RH_SQL_ENCRYPT=yes
RH_SQL_TRUST_SERVER_CERTIFICATE=true
RH_SQL_TIMEOUT_SECONDS=10

# Autenticação/bootstrap local
RH_AUTH_USER=rh.local
RH_AUTH_PASSWORD=
RH_AUTH_TOKEN_SECRET=
RH_AUTH_TOKEN_TTL_MINUTES=480
RH_AUTH_LOGIN_RATE_LIMIT=5
RH_AUTH_LOGIN_RATE_WINDOW_SECONDS=60
RH_MFA_ISSUER=Conecta
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RH_MFA_ENCRYPTION_KEY=

# Em PROD mantenha false e aplique infra/sql/migrations antes do deploy.
RH_SCHEMA_BOOTSTRAP_ENABLED=true

# URL publica de candidatura
# Deixe vazio para links internos no mesmo host. Configure dominio/IP publico
# quando a pagina de candidatura precisar ser compartilhada fora do servidor.
RH_PUBLIC_FRONTEND_BASE_URL=
RH_PUBLIC_CANDIDATE_BASE_URL=
RH_PUBLIC_CV_UPLOAD_DIR=data/private/public-cvs

# Conversão de currículos legados
DOC_CONVERTER=auto
LIBREOFFICE_PATH=

# CORS
# Com frontend servido pelo proprio backend, deixe vazio na maior parte dos casos.
# Preencha apenas para frontends externos autorizados, separados por virgula.
RH_CORS_ALLOW_ORIGINS=
RH_CORS_ALLOW_ORIGIN_REGEX=

# Análise de currículo com IA (sempre opcional)
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=60
AI_MAX_CURRICULO_CHARS=30000
AI_DUPLICATE_WINDOW_SECONDS=30

# Caixa de curriculos por IMAP/Microsoft Graph
RH_EMAIL_INBOX_ENABLED=false
RH_EMAIL_INBOX_PROVIDER=microsoft365
RH_EMAIL_INBOX_PROTOCOL=imap
RH_EMAIL_INBOX_MODE=imap
RH_EMAIL_INBOX_AUTH_MODE=oauth2
RH_EMAIL_INBOX_IMAP_HOST=outlook.office365.com
RH_EMAIL_INBOX_IMAP_PORT=993
RH_EMAIL_INBOX_ADDRESS=
RH_EMAIL_INBOX_USERNAME=
RH_EMAIL_INBOX_MAILBOX=INBOX
RH_EMAIL_INBOX_TENANT_ID=
RH_EMAIL_INBOX_CLIENT_ID=
RH_EMAIL_INBOX_CLIENT_SECRET_ENV=RH_EMAIL_CLIENT_SECRET
RH_EMAIL_CLIENT_SECRET=
RH_EMAIL_INBOX_SCOPES=https://outlook.office365.com/.default
RH_EMAIL_INBOX_PASSWORD_ENV=RH_EMAIL_PASSWORD
RH_EMAIL_PASSWORD=
RH_EMAIL_INBOX_MAX_MESSAGES=50
RH_EMAIL_INBOX_MAX_ATTACHMENT_MB=10
RH_EMAIL_INBOX_ATTACHMENTS_DIR=data/private/email_attachments

# Microsoft Graph legado/alternativo
RH_EMAIL_GRAPH_TENANT_ID=
RH_EMAIL_GRAPH_CLIENT_ID=
RH_EMAIL_GRAPH_CLIENT_SECRET_ENV=RH_EMAIL_GRAPH_CLIENT_SECRET
RH_EMAIL_GRAPH_CLIENT_SECRET=
RH_EMAIL_GRAPH_MAILBOX=
RH_EMAIL_GRAPH_SCOPE=https://graph.microsoft.com/.default
RH_EMAIL_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Envio de e-mail (Mail.Send como aplicação, mesma caixa do RH_EMAIL_GRAPH_MAILBOX acima)
# Exige Application Access Policy no Exchange restringindo o app só a essa caixa.
RH_EMAIL_SEND_CLIENT_SECRET_ENV=RH_EMAIL_GRAPH_CLIENT_SECRET

# Repositório de arquivos M365 (OneDrive/SharePoint do site do RH)
# Reaproveita por padrão as credenciais MICROSOFT_CLIENT_ID/TENANT_ID/CLIENT_SECRET
# já usadas no login SSO (1 único service principal, client credentials, sobre o Site RH).
RH_SHAREPOINT_SITE_ID=
RH_SHAREPOINT_DRIVE_ID=
RH_SHAREPOINT_TENANT_ID=
RH_SHAREPOINT_CLIENT_ID=
RH_SHAREPOINT_CLIENT_SECRET_ENV=MICROSOFT_CLIENT_SECRET
RH_SHAREPOINT_SCOPE=https://graph.microsoft.com/.default
RH_SHAREPOINT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# SMTP
RH_EMAIL_SMTP_ENABLED=false
RH_EMAIL_SMTP_HOST=
RH_EMAIL_SMTP_PORT=587
RH_EMAIL_SMTP_USERNAME=
RH_EMAIL_SMTP_PASSWORD_ENV=RH_EMAIL_APP_PASSWORD
RH_EMAIL_APP_PASSWORD=
RH_EMAIL_SMTP_FROM=
RH_EMAIL_SMTP_USE_TLS=true
RH_EMAIL_SMTP_USE_SSL=false

# Arquivamento de logs do sistema em ZIP (job diario, opcional). Logs da Monitoria (imutaveis) nunca sao tocados.
# RH_LOG_ARCHIVE_ENABLED=true
# RH_LOG_ARCHIVE_DAYS=90
# RH_LOG_ARCHIVE_DIR=data/private/log-archive
# RH_LOG_ARCHIVE_BATCH=20000
